# Copy to .env.local (git-ignored). Production values live in Vercel project env vars.

# --- Browser (bundled into the client; publishable values only) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Show "Connect Facebook" once the Meta app + Supabase Facebook provider are configured.
VITE_FB_LOGIN_ENABLED=false

# --- Server only (Vercel Functions in api/). NEVER prefix these with VITE_. ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
